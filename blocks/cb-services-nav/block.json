{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "cb-chillibyte-2026/cb-services-nav",
  "title": "CB Services Nav",
  "category": "cb-chillibyte-2026",
  "icon": "cover-image",
  "attributes": {
    "title": {
      "type": "string",
      "default": ""
    },
    "intro": {
