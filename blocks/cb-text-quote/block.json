{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "cb-chillibyte-2026/cb-text-quote",
  "title": "CB Text Quote",
  "category": "cb-chillibyte-2026",
  "icon": "cover-image",
  "attributes": {
    "title": {
      "type": "string",
      "default": ""
    },
    "content": {
      "type": "string",
      "default": ""
    },
    "ctaText": {
      "type": "string",
      "default": ""
    },
    "ctaUrl": {
      "type": "string",
      "default": ""
    },
    "ctaTarget": {
      "type": "boolean",
      "default": false
    },
    "quoteBody": {
      "type": "string",
      "default": ""
    },
    "quoteAttribution": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "anchor": true,
    "className": true,
    "align": true,
    "color": {
      "background": true,
      "text": true
    }
  },
  "editorScript": "file:./build/index.js",
  "render": "file:./render.php"
}
